<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-account-lifecycle-table" author="ms-account">
        <createTable tableName="account_lifecycle">
            <column name="user_id" type="VARCHAR(64)">
                <constraints primaryKey="true" primaryKeyName="pk_account_lifecycle" nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)" defaultValue="PENDING_DELETION">
                <constraints nullable="false"/>
            </column>
            <column name="requested_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="purge_at" type="TIMESTAMP WITH TIME ZONE">
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="account_lifecycle"/>
        </rollback>
    </changeSet>

    <changeSet id="create-idx-account-lifecycle-sweeper" author="ms-account">
        <sql dbms="postgresql">
            CREATE INDEX idx_account_lifecycle_sweeper
                ON account_lifecycle (purge_at) WHERE status = 'PENDING_DELETION';
        </sql>
        <rollback>
            <dropIndex indexName="idx_account_lifecycle_sweeper" tableName="account_lifecycle"/>
        </rollback>
    </changeSet>

</databaseChangeLog>